# ==========================================
# NagarHelp Frontend — Environment Variables
# ==========================================
# Copy this file to .env and fill in your real values.
# NEVER commit your actual .env to version control.

# ── API Endpoints ─────────────────────────
# Backend server URL (leave empty to use Vite proxy in dev)
VITE_API_URL=http://localhost:5000
VITE_SOCKET_URL=http://localhost:5000

# ── Google Maps ───────────────────────────
# Get from: https://cloud.google.com/maps-platform/
VITE_GOOGLE_MAPS_API_KEY=your_google_maps_api_key

# ── Firebase Client SDK ───────────────────
# Get from: Firebase Console → Project Settings → Your apps → Web app config
VITE_FIREBASE_API_KEY=your_firebase_api_key
VITE_FIREBASE_AUTH_DOMAIN=your-project-id.firebaseapp.com
VITE_FIREBASE_DB_URL=https://your-project-id-default-rtdb.firebaseio.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-project-id.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=000000000000
VITE_FIREBASE_APP_ID=1:000000000000:web:xxxxxxxxxxxxxxxxxxxx
VITE_FIREBASE_MEASUREMENT_ID=G-XXXXXXXXXX

# ── Backend API Base (used by AuthContext & OTPVerify) ──
# Must match VITE_API_URL
VITE_API_BASE_URL=http://localhost:5000
