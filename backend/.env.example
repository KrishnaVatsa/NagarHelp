# =========================================
# NagarHelp Backend — Environment Variables
# =========================================
# Copy this file to .env and fill in your real values.
# NEVER commit your actual .env to version control.



# ── Server ───────────────────────────────
PORT=5000
NODE_ENV=development
FRONTEND_URL=http://localhost:5173

# ── MongoDB ──────────────────────────────
# Get from: https://cloud.mongodb.com (Atlas)
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/nagarhelp_db

# ── Firebase Admin SDK ───────────────────
# OPTION A (Recommended for production): Paste the full service account JSON as a single line
# Get from: Firebase Console → Project Settings → Service Accounts → Generate New Private Key
FIREBASE_SERVICE_ACCOUNT={"type":"service_account","project_id":"...","private_key":"...","client_email":"..."}

# OPTION B (Local dev): Path to the downloaded service account JSON file
# GOOGLE_APPLICATION_CREDENTIALS=./google-credentials.json

# Required for Realtime Database and Storage
FIREBASE_DB_URL=https://<your-project-id>.firebaseio.com
FIREBASE_STORAGE_BUCKET=<your-project-id>.appspot.com

# ── Google Gemini AI ─────────────────────
# Get from: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# ── Email (OTP Delivery) ─────────────────
# Use a Gmail app password: https://myaccount.google.com/apppasswords
EMAIL_SERVICE=gmail
EMAIL_USER=your_email@gmail.com
EMAIL_PASSWORD=xxxx xxxx xxxx xxxx
EMAIL_FROM=NagarHelp <noreply@nagarhelp.com>

# ── WhatsApp (Whapi.cloud) ───────────────
# Get from: https://whapi.cloud
WHAPI_TOKEN=your_whapi_bearer_token
WHAPI_INSTANCE_URL=https://gate.whapi.cloud/instances/<your-instance-id>
ADMIN_WHATSAPP_NUMBER=+91XXXXXXXXXX

# ── SOS Dispatch Algorithm ───────────────
# Tune these weights to adjust responder scoring (must sum to 1.0)
WEIGHT_ETA=0.5
WEIGHT_SKILL=0.3
WEIGHT_TRUST=0.2
SEARCH_RADIUS_KM=5
MIN_TRUST_SCORE=0.3
